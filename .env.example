# Server
PORT=3000
HOST=0.0.0.0
# Path to the SQLite database file (created on first run). Use ":memory:" for an ephemeral DB.
DATABASE_PATH=./data/tagpile.sqlite
# Set to "production" when running a built server. Any other value serves API only (client via Vite).
NODE_ENV=development
# Optional override for the secret used to sign/verify auth JWTs. When unset, the server
# generates one on first boot and stores it in the database, so deleting the database
# invalidates all issued sessions.
#JWT_SECRET=
# Directories that may hold libraries. An admin can create a library only in one of these
# directories or below it. Separate entries with ":" (";" on Windows). When unset, no library
# can be created or moved.
#LIBRARY_ROOTS=/srv/media:/mnt/photos
# Built-in HTTPS. Set both to the PEM certificate and private key files to serve HTTPS. When
# unset, the server speaks plain HTTP: use that only on 127.0.0.1 or a network you trust.
#TLS_CERT_FILE=/etc/tagpile/cert.pem
#TLS_KEY_FILE=/etc/tagpile/key.pem
# Adds the Secure attribute to session cookies. Defaults to true when the TLS files are set.
# Set it to true when a reverse proxy in front of TagPile ends HTTPS.
#COOKIE_SECURE=true
# Trust X-Forwarded-* headers from a reverse proxy (true, a hop count, or addresses such as
# "loopback"). The login rate limit uses the client address that this setting gives.
#TRUST_PROXY=loopback
